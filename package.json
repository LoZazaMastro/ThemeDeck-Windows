{
  "name": "themedeck",
  "version": "3.3.5",
  "description": "A Windows-friendly Decky Loader fork of ThemeDeck for game, ambient, and store music in Steam Gaming Mode.",
  "type": "module",
  "scripts": {
    "stamp": "node scripts/stamp-build.mjs",
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "tsc --noEmit && python -B -m unittest discover -s tests && node --test tests/*.test.mjs",
    "build:offline": "node scripts/build-offline.mjs",
    "test:runtime": "python -B -m unittest discover -s tests && node --test tests/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LoZazaMastro/ThemeDeck-Windows.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "music",
    "themes"
  ],
  "author": "BrenticusMaximus, LoZazaMastro",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/LoZazaMastro/ThemeDeck-Windows/issues"
  },
  "homepage": "https://github.com/LoZazaMastro/ThemeDeck-Windows#readme",
  "devDependencies": {
    "@decky/rollup": "1.0.1",
    "@decky/ui": "4.7.2",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/webpack": "^5.28.5",
    "rollup": "4.22.5",
    "typescript": "5.6.2"
  },
  "dependencies": {
    "@decky/api": "1.1.2",
    "react-icons": "5.3.0",
    "tslib": "2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
